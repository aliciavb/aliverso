---
// src/pages/mezcla.astro — mezcla de /escueta y /suelta (2026-09-24): el texto suelto sobre el
// velado como en sam-peitz.com, pero en frases completas y con mayúsculas, sin titular en
// negrita. El resto es igual que /escueta (sin filetes ni etiquetas pequeñas).
import VeladoLayout from "../layouts/VeladoLayout.astro";
import Trabajo from "../components/home/TrabajoMesa.astro";
import { cases } from "../data/cases";
import Recorrido from "../components/home/Recorrido.astro";
import "../styles/escueta.css";

const pageTitle = "Alicia Viñals — Diseño y desarrollo web";
const pageDescription = "Diseño y programo webs para proyectos pequeños y profesionales creativos, desde 2022.";
const email = "hola@aliverso.me";
---

<VeladoLayout title={pageTitle} description={pageDescription}>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&display=swap"
  />
  <div class="escueta mezcla">
    <div class="top">
      <canvas id="bg" aria-hidden="true"></canvas>
      <div class="wrap">
        <header class="site">
          <a class="brand" href="/mezcla">Alicia Viñals</a>
          <nav class="site" aria-label="Principal">
            <a href="#trabajo">Trabajo</a>
            <a href="#hablemos">Hablemos</a>
          </nav>
        </header>

        <main>
          <section class="suelta" aria-label="Presentación">
            <h1 class="g g1">Hola, soy Alicia.</h1>
            <p class="g g2">
              Diseño y programo webs para proyectos pequeños y gente creativa. Llevo desde 2022
              cerrando la brecha entre diseño e implementación.
            </p>
            <p class="g g3"><a href="#trabajo">Estas son algunas</a> ↓ &nbsp;o <a href="#hablemos">escríbeme</a>.</p>
          </section>
        </main>
      </div>
    </div>

    <div class="wrap">
      <Trabajo cases={cases} />

      <Recorrido />

      <section class="block" id="hablemos">
        <div class="talk">
          <div>
            <h2 class="title">¿Quieres una?</h2>
            <p>Cuéntame qué necesitas, para cuándo y con qué presupuesto cuentas.</p>
            <a class="btn" href={`mailto:${email}`}>{email}</a>
            <p>Te contesto en menos de 24 horas laborables.</p>
            <p><a class="link" href="https://www.linkedin.com/in/alicia-vb" target="_blank" rel="noopener">LinkedIn</a></p>
          </div>
          <img
            class="analog"
            src="/assets/nubes-900.webp"
            srcset="/assets/nubes-900.webp 900w, /assets/nubes-1200.webp 1200w"
            sizes="(max-width: 720px) 100vw, 560px"
            width="1200" height="800"
            loading="lazy"
            alt="Nubes al atardecer desde la ventanilla de un avión, foto analógica de cámara desechable"
          />
        </div>
      </section>

      <footer class="site">
        <span class="firma">siempre creando</span>
        <span>© 2026 Alicia Viñals</span>
      </footer>
    </div>
  </div>
</VeladoLayout>

<style>
  /* Tipografías elegidas el 2026-09-24: Outfit para todo, también el hero (en mono se sentía
     otra web); Azeret Mono solo en las pestañas de las carpetas y detalles cortos. Sustituyen a Bricolage + Instrument Sans + Plex Mono. */
  @font-face {
    font-family: "Outfit";
    src: url("/fonts/Outfit-Variable.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }
  .mezcla {
    --display: "Outfit", system-ui, sans-serif;
    --mono: "Azeret Mono", ui-monospace, monospace;
    font-family: "Outfit", system-ui, sans-serif;
    overflow-x: clip; /* la línea de Cómo trabajo sale de la pantalla */
  }

  /* Texto suelto a distintas alturas y sangrías (idea de sam-peitz.com), en frases completas */
  .suelta {
    display: grid; align-content: space-evenly; min-height: 72svh; padding-block: 24px 48px;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem); line-height: 1.35; letter-spacing: -.005em;
  }
  .suelta .g { margin-block: 0; text-shadow: 0 1px 24px color-mix(in srgb, var(--ground-deep) 45%, transparent); }
  .suelta h1 { font: inherit; }
  .suelta a { color: var(--ink); text-underline-offset: 4px; }
  .g1 { margin-left: 4%; }
  .g2 { margin-left: 40%; max-width: 36ch; }
  .g3 { margin-left: 12%; }
  @media (max-width: 600px) {
    .g2 { margin-left: 14%; }
  }
</style>

<script>
  import { initVelado } from "../scripts/velado";

  const canvas = document.getElementById("bg");
  if (canvas instanceof HTMLCanvasElement) initVelado(canvas);
</script>
