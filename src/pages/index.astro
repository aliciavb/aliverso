---
// src/pages/index.astro — la home (versión "mezcla", elegida el 2026-09-24): el texto suelto sobre
// el velado como en sam-peitz.com, las carpetas en la alfombrilla, el recorrido de Cómo trabajo y
// el Sobre mí con la foto en la cámara. Los textos viven en src/data/*.json.
import VeladoLayout from "../layouts/VeladoLayout.astro";
import Trabajo from "../components/home/TrabajoMesa.astro";
import { cases } from "../data/cases";
import Recorrido from "../components/home/Recorrido.astro";
import Postal from "../components/home/Postal.astro";
import home from "../data/home.json";
import { formato, parrafos } from "../lib/formato";
import "../styles/escueta.css";

const { seo, hero, sobreMi, contacto, firma } = home;
---

<VeladoLayout title={seo.titulo} description={seo.descripcion}>
  <div class="escueta mezcla">
    <div class="top">
      <canvas id="bg" aria-hidden="true"></canvas>
      <div class="wrap">
        <header class="site">
          <a class="brand" href="/">Alicia Viñals</a>
          <nav class="site" aria-label="Principal">
            <a href="#trabajo">Trabajo</a>
            <a href="#sobre-mi">Sobre mí</a>
            <a href="#hablemos">Hablemos</a>
          </nav>
        </header>

        <main>
          <section class="suelta" aria-label="Presentación">
            <h1 class="g g1">{hero.saludo}</h1>
            <p class="g g2" set:html={formato(hero.texto)} />
            <p class="g g3"><a href="#trabajo">{hero.enlaceTrabajo}</a> ↓ &nbsp;o <a href="#hablemos">{hero.enlaceContacto}</a>.</p>
          </section>
        </main>
      </div>
    </div>

    <div class="wrap">
      <Trabajo cases={cases} />

      <Recorrido />

      <section class="block" id="sobre-mi" aria-label="Sobre mí">
        <div class="about">
          <div class="cam" data-frames="8" data-ms-in="40" data-ms-out="55" data-intro-delay="1200">
            <div class="screen" role="img" aria-label="Alicia Viñals"></div>
            <img class="frame" src="/assets/perfil-camara.png" alt="" />
          </div>
          <div>
            <h2 class="title">{sobreMi.titulo}</h2>
            <Fragment set:html={parrafos(sobreMi.texto)} />
          </div>
        </div>
      </section>

      <section class="block" id="hablemos">
        <div class="talk">
          <div>
            <h2 class="title">{contacto.titulo}</h2>
            <p set:html={formato(contacto.texto)} />
            <a class="btn" href={`mailto:${contacto.email}${contacto.asunto ? `?subject=${encodeURIComponent(contacto.asunto)}` : ""}`}>{contacto.email}</a>
            <p set:html={formato(contacto.nota)} />
            {contacto.linkedin && <p><a class="link" href={contacto.linkedin} target="_blank" rel="noopener">LinkedIn</a></p>}
          </div>
          <Postal mensaje={contacto.postal} email={contacto.email} />
        </div>
      </section>

      <footer class="site">
        <span class="firma">{firma}</span>
        <span>© 2026 Alicia Viñals</span>
      </footer>
    </div>
  </div>
</VeladoLayout>

<style>
  /* Tipografías (Outfit + Azeret Mono) definidas para toda la web en velado.css y VeladoLayout */
  /* La línea de Cómo trabajo sale de la pantalla: se recorta en la página entera. En .mezcla
     cortaba también los bordes del hero, que se sale del contenedor para llegar de lado a lado. */
  :global(body) { overflow-x: clip; }
  /* El pie ya lleva su propio aire: sin el relleno de 96px del body, que dejaba un hueco vacío
     debajo de «© 2026» al llegar al final */
  :global(body) { padding-bottom: 0; }

  /* Texto suelto a distintas alturas y sangrías (idea de sam-peitz.com), en frases completas */
  .suelta {
    display: grid; align-content: space-evenly; min-height: 72svh; padding-block: 24px 48px;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem); line-height: 1.35; letter-spacing: -.005em;
  }
  .suelta .g { margin-block: 0; text-shadow: 0 1px 24px color-mix(in srgb, var(--ground-deep) 45%, transparent); }
  .suelta h1 { font: inherit; }
  .suelta a { color: var(--ink); text-underline-offset: 4px; }
  .g1 { margin-left: 4%; }
  .g2 { margin-left: 40%; max-width: 36ch; }
  .g3 { margin-left: 12%; }
  /* En móvil la escalera se exagera: con 4/14/12 % parecía un descuadre (2026-09-28) */
  @media (max-width: 600px) {
    .g1 { margin-left: 0; }
    .g2 { margin-left: 32%; }
  }
</style>

<script>
  import { initVelado, initCamara } from "../scripts/velado";

  const canvas = document.getElementById("bg");
  // El velado se dibuja después del primer pintado: el fondo ya lleva su degradado mientras tanto
  if (canvas instanceof HTMLCanvasElement) requestAnimationFrame(() => setTimeout(() => initVelado(canvas)));
  document.querySelectorAll<HTMLElement>(".cam").forEach(initCamara);
</script>
