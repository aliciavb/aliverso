---
// src/pages/index.astro — front door (textos cerrados el 2026-09-21, diseño del prototipo velado v7)
import VeladoLayout from "../layouts/VeladoLayout.astro";

const pageTitle = "Alicia Viñals — Diseño y desarrollo web";
const pageDescription =
  "Diseño y programo webs completas para proyectos pequeños y profesionales creativos, desde 2022.";

const reasons = [
  {
    title: "Lo que haces está repartido.",
    text: "Un Instagram, un PDF, un enlace en la bio. Necesitas un sitio que lo reúna todo y lo enseñe como se merece.",
  },
  {
    title: "Tu web se ha quedado vieja.",
    text: "Funciona, pero ya no se parece a lo que haces hoy.",
  },
  {
    title: "Tienes web, pero no la tocas.",
    text: "No sabes, no tienes tiempo o no tienes a quién pedírselo, y se queda desactualizada.",
  },
];

const cases = [
  {
    name: "Galería i23",
    meta: "Web de apertura · WordPress",
    image: null, // pendiente: captura de la web de su época (Wayback Machine o archivo propio)
    problem:
      "La galería aún no existía. Tenían el local en la calle Ibiza 23, la identidad de marca hecha y un Instagram que anunciaba la apertura. Necesitaban la web para abrir.",
    decision:
      "Pasé su identidad a la web y la programé en WordPress. Podía montar cada exposición como una página suelta, pero preparé una estructura para que publicar una nueva fuera rellenar una ficha, tanto para mí como para quien la editara después.",
    result: "La galería lleva tres temporadas de exposiciones publicadas por su cuenta, sin mí.",
  },
  {
    name: "Escuela TAI",
    meta: "Mantenimiento y diseño · 2022–2024",
    image: "/assets/projects/taiarts-home.webp",
    problem:
      "Es la web de una escuela universitaria de artes: fichas de cada carrera, páginas de cada departamento, formularios de captación, campañas. La visitan a diario futuros alumnos y alumnos actuales, así que tiene que estar siempre al día y bien cuidada.",
    decision:
      "De 2022 a 2024 fui quien la mantenía. Recogía en reunión lo que pedía cada departamento y lo llevaba a la web: formularios, portada, fechas, módulos nuevos y rediseños de los que ya había. Diseñé una landing que después sirvió de referencia para las siguientes.",
    result:
      "Sigue online y la editan ellos. En diciembre de 2025, un año después de irme, me volvieron a llamar para cubrir una baja.",
  },
];

const steps = [
  {
    title: "Primero, contexto.",
    text: "Qué tienes ya, qué echas en falta, si tienes el contenido listo, si tienes dominio y servidor y si sabes lo que cuesta todo eso. Lo que más retrasa una web es el contenido, así que eso se ve al principio y no al final.",
  },
  {
    title: "Diseño antes de programar.",
    text: "Ves cómo va a quedar antes de que construya nada, y te enseño avances sobre la marcha. Lo que apruebas en el diseño es lo que se publica, porque no pasa por otras manos.",
  },
  {
    title: "Cambios.",
    text: "Los retoques sobre el diseño van incluidos. Si la idea cambia a mitad de camino, se habla y se presupuesta aparte.",
  },
  {
    title: "Entrega.",
    text: "La web publicada y una reunión en la que te enseño a usarla, para que no dependas de mí.",
  },
];

const email = "hola@aliverso.me";
---

<VeladoLayout title={pageTitle} description={pageDescription}>
  <div class="top">
    <canvas id="bg" aria-hidden="true"></canvas>
    <div class="wrap">
      <header class="site">
        <a class="brand" href="/">Alicia Viñals</a>
        <nav class="site" aria-label="Principal">
          <a href="#trabajo">Trabajo</a>
          <a href="#sobre-mi">Sobre mí</a>
          <a href="#hablemos">Hablemos</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <span class="mono">Alicia VB · Diseño y desarrollo web · Madrid</span>
          <h1>Una web que dé la <em>cara</em> por tu proyecto.</h1>
          <p>Diseño y programo webs completas para proyectos pequeños y profesionales creativos, desde 2022.</p>
          <div class="cta">
            <a class="btn" href="#hablemos">Cuéntame tu proyecto</a>
            <a class="link" href="#trabajo">Ver trabajo</a>
          </div>
        </section>
      </main>
    </div>
  </div>

  <div class="wrap">
    <section class="lead">
      <h2>Tú ya tienes una marca. Yo le doy el espacio que merece en internet.</h2>
      <p>
        Llegas con tu identidad hecha: tu logo, tus colores, tu forma de contar lo que haces. Mi trabajo es llevar eso
        a una web que esté a su altura, no inventarte una marca nueva.
      </p>
    </section>

    <section class="block" id="servicios">
      <div class="block-head"><span class="mono">Con qué me suelen llamar</span></div>
      <ul class="reasons">
        {reasons.map((r) => (
          <li>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
      <p class="after">
        A partir de ahí, lo que haga falta: una web entera, una landing de evento, una sección nueva dentro de algo que
        ya existe, o rehacer cómo se ve todo.
      </p>
    </section>

    <section class="block" id="trabajo">
      <div class="block-head"><span class="mono">Trabajo</span><span class="mono">{cases.length} casos</span></div>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            {c.image ? (
              <img class="case-img" src={c.image} alt={`Web de ${c.name}`} loading="lazy" />
            ) : (
              <div class="case-img slot"><span class="mono">Imagen pendiente · {c.name}</span></div>
            )}
            <div class="case-head">
              <h3>{c.name}</h3>
              <span class="mono">{c.meta}</span>
            </div>
            <p class="case-result">{c.result}</p>
            <details>
              <summary class="mono">Cómo fue</summary>
              <dl>
                <div><dt>Problema</dt><dd>{c.problem}</dd></div>
                <div><dt>Decisión</dt><dd>{c.decision}</dd></div>
              </dl>
            </details>
          </article>
        ))}
        <!-- Tercer caso: pendiente de elegir (web personal de creativo; Carmen Lillo por delante). Quitar antes de publicar. -->
        <article class="case pending">
          <span class="mono">Tercer caso · pendiente de elegir</span>
        </article>
      </div>
    </section>

    <section class="block" id="como-trabajo">
      <div class="block-head"><span class="mono">Cómo trabajo</span></div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="note">
        <p>
          <strong>Sobre la IA.</strong> La uso para ir más rápido en lo que no es criterio: ordenar información,
          investigar referencias, escribir y revisar código. No decide el diseño ni hace tu identidad ni las
          ilustraciones. Eso lo hago yo, y lo que tiene que ser hecho a mano lo hago a mano.
        </p>
      </div>
    </section>

    <section class="block" id="sobre-mi">
      <div class="block-head"><span class="mono">Sobre mí</span><span class="mono">Madrid</span></div>
      <div class="about">
        <div class="cam" data-frames="8" data-ms-in="40" data-ms-out="55" data-intro-delay="1200">
          <div class="screen" role="img" aria-label="Alicia Viñals"></div>
          <img class="frame" src="/assets/perfil-camara.png" alt="" />
        </div>
        <div>
          <h2 class="title">Alicia Viñals</h2>
          <p>
            Soy madrileña y llevo desde 2022 cerrando la brecha entre diseño e implementación. Empecé en el diseño
            gráfico estudiando Bellas Artes, pasé al diseño web y del diseño web a programar, en 42 Madrid. Lo que
            busco en cada proyecto es que tu web te sirva para lo que la necesitas: conseguir clientes, publicar lo
            que haces o enseñar lo que vales.
          </p>
        </div>
      </div>
    </section>

    <section class="block" id="hablemos">
      <div class="talk">
        <div>
          <h2 class="title">Hablemos</h2>
          <p>Escríbeme a {email} y cuéntame:</p>
          <ul>
            <li>qué necesitas,</li>
            <li>para cuándo,</li>
            <li>y con qué presupuesto cuentas.</li>
          </ul>
          <a class="btn" href={`mailto:${email}`}>{email}</a>
          <p>Te contesto en menos de 24 horas laborables.</p>
        </div>
        <div class="photo-slot">
          <div>
            <strong>Tu foto analógica va aquí</strong>
            <span class="mono">La de las nubes, desechable</span>
          </div>
        </div>
      </div>
    </section>

    <footer class="site">
      <span class="mono">© 2026 Alicia Viñals</span>
      <span class="mono">Madrid</span>
    </footer>
  </div>
</VeladoLayout>

<script>
  import { initVelado, initCamara } from "../scripts/velado";

  const canvas = document.getElementById("bg");
  if (canvas instanceof HTMLCanvasElement) initVelado(canvas);
  document.querySelectorAll<HTMLElement>(".cam").forEach(initCamara);
</script>
