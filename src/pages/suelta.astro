---
// src/pages/suelta.astro — /escueta con el hero "a lo Sam" (2026-09-24): frases cortas en
// minúsculas, sueltas sobre el velado, como sam-peitz.com. El resto es igual que /escueta.
import VeladoLayout from "../layouts/VeladoLayout.astro";
import Trabajo from "../components/home/Trabajo.astro";
import { cases } from "../data/cases";
import { steps } from "../data/steps";
import "../styles/escueta.css";

const pageTitle = "Alicia Viñals — Diseño y desarrollo web";
const pageDescription = "Diseño y programo webs para proyectos pequeños y profesionales creativos, desde 2022.";
const email = "hola@aliverso.me";
---

<VeladoLayout title={pageTitle} description={pageDescription}>
  <div class="escueta">
    <div class="top">
      <canvas id="bg" aria-hidden="true"></canvas>
      <div class="wrap">
        <header class="site">
          <a class="brand" href="/suelta">Alicia Viñals</a>
          <nav class="site" aria-label="Principal">
            <a href="#trabajo">Trabajo</a>
            <a href="#hablemos">Hablemos</a>
          </nav>
        </header>

        <main>
          <section class="suelta" aria-label="Presentación">
            <h1 class="g g1">hola, soy alicia</h1>
            <p class="g g2">diseño y programo webs</p>
            <p class="g g3">para proyectos pequeños<br />y gente creativa</p>
            <p class="g g4"><a href="#trabajo">estas son algunas ↓</a></p>
            <p class="g g5"><a href="#hablemos">o escríbeme</a></p>
          </section>
        </main>
      </div>
    </div>

    <div class="wrap">
      <Trabajo cases={cases} />

      <section class="block" id="como-trabajo" aria-label="Cómo trabajo">
        <h2 class="title">Cómo trabajo</h2>
        <ol class="big-steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="block" id="hablemos">
        <div class="talk">
          <div>
            <h2 class="title">¿Quieres una?</h2>
            <p>Cuéntame qué necesitas, para cuándo y con qué presupuesto cuentas.</p>
            <a class="btn" href={`mailto:${email}`}>{email}</a>
            <p>Te contesto en menos de 24 horas laborables.</p>
            <p><a class="link" href="https://www.linkedin.com/in/alicia-vb" target="_blank" rel="noopener">LinkedIn</a></p>
          </div>
          <img
            class="analog"
            src="/assets/nubes-900.webp"
            srcset="/assets/nubes-900.webp 900w, /assets/nubes-1200.webp 1200w"
            sizes="(max-width: 720px) 100vw, 560px"
            width="1200" height="800"
            loading="lazy"
            alt="Nubes al atardecer desde la ventanilla de un avión, foto analógica de cámara desechable"
          />
        </div>
      </section>

      <footer class="site">
        <span class="firma">siempre creando</span>
        <span>© 2026 Alicia Viñals</span>
      </footer>
    </div>
  </div>
</VeladoLayout>

<style>
  /* Frases sueltas a distintas alturas y sangrías, como el texto de sam-peitz.com */
  .suelta {
    display: grid; align-content: space-evenly; min-height: 70svh; padding-block: 24px 48px;
    font-family: var(--mono); font-size: clamp(1.0625rem, 1.7vw, 1.3125rem); line-height: 1.35;
  }
  .suelta .g { margin-block: 0; text-shadow: 0 1px 24px color-mix(in srgb, var(--ground-deep) 45%, transparent); }
  .suelta h1 { font: inherit; }
  .suelta a { color: var(--ink); text-underline-offset: 4px; }
  .g1 { margin-left: 4%; }
  .g2 { margin-left: 52%; }
  .g3 { margin-left: 24%; }
  .g4 { margin-left: 60%; }
  .g5 { margin-left: 12%; }
  @media (max-width: 600px) {
    .g2 { margin-left: 30%; } .g4 { margin-left: 36%; }
  }
</style>

<script>
  import { initVelado } from "../scripts/velado";

  const canvas = document.getElementById("bg");
  if (canvas instanceof HTMLCanvasElement) initVelado(canvas);
</script>
