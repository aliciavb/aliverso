---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Contact — Alicia V";
const pageDescription =
  "Get in touch. Let's talk about design, code, or creative collaborations.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="page-contact">
    <section class="contact-hero">
      <h1 class="page-title">Let's connect</h1>
      <p class="page-subtitle">
        Open to collaborations, creative projects, and conversations
      </p>
    </section>

    <section class="contact-links">
      <a href="mailto:alivinals@gmail.com" class="contact-card">
        <span class="card-label">Email</span>
        <span class="card-value">alivinals@gmail.com</span>
      </a>

      <a
        href="https://linkedin.com/in/alicia-vb"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <span class="card-label">LinkedIn</span>
        <span class="card-value">linkedin.com/in/alicia-vb</span>
      </a>

      <a
        href="https://github.com/aliciavb"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card"
      >
        <span class="card-label">GitHub</span>
        <span class="card-value">github.com/aliciavb</span>
      </a>

	  
      <a href="mailto:alivinals@gmail.com" class="contact-card">
        <span class="card-label">42 Slack</span>
        <span class="card-value">@avinals-</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .page-contact {
    min-height: 100vh;
    padding-top: 6rem;
    max-width: 800px;
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Hero */
  .contact-hero {
    text-align: center;
    padding: 4rem 0 3rem;
  }

  .page-title {
    font-size: 3.5rem;
    margin: 0 0 1rem;
    color: var(--color-green);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  /* Contact Cards */
  .contact-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 2rem 0 4rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-green);
    box-shadow: 0 8px 24px rgba(134, 235, 79, 0.1);
    background: rgba(255, 255, 255, 0.05);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .card-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-purple);
    font-weight: 600;
  }

  .card-value {
    font-size: 1.125rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .contact-card:hover .card-value {
    color: var(--color-green);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-contact {
      padding-top: 5rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .contact-hero {
      padding: 3rem 0 2rem;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .page-subtitle {
      font-size: 1rem;
    }

    .contact-links {
      padding: 1.5rem 0 3rem;
    }

    .contact-card {
      padding: 1.5rem;
    }

    .card-icon {
      font-size: 1.75rem;
    }

    .card-value {
      font-size: 1rem;
      word-break: break-all;
    }
  }
</style>
