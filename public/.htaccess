# aliverso.me en Hostinger (Apache). La web es estática: index.html manda sobre cualquier index.php.
DirectoryIndex index.html

RewriteEngine On

# https y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://aliverso.me/$1 [R=301,L]

# URLs del WordPress antiguo con equivalente en la home.
# /pagina-ejemplo/ y /under-construction/ se dejan en 404 a propósito.
RewriteRule ^sobre-mi/?$ https://aliverso.me/#sobre-mi [R=301,NE,L]
RewriteRule ^playground/?$ https://aliverso.me/ [R=301,L]

# Caché: el HTML siempre fresco; CSS y JS llevan hash en el nombre
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
